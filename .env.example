# ── Backend ───────────────────────────────────────────────────────
# JWT signing secret — MUST be changed before production deployment
JWT_SECRET=<replace-with-a-random-64-char-string>

# SQLite database path (inside container, do not change unless you update docker-compose.yml volumes)
DATABASE_URL=file:/app/data/db.sqlite

# Server port
PORT=4000

# ── SMTP (optional — for email notifications) ─────────────────────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=<your-smtp-username>
# SMTP_PASS=<your-smtp-password>
# SMTP_FROM=<noreply@yourdomain.com>

# ── Web Push (optional — for PWA push notifications) ──────────────
# VAPID_PUBLIC_KEY=<your-vapid-public-key>
# VAPID_PRIVATE_KEY=<your-vapid-private-key>
# VAPID_SUBJECT=mailto:<your-email>
