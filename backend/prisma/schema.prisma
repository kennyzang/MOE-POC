generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ───────────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String
  displayName String
  email       String?
  role        String   // student, teacher, parent, admin, manager, finance, admissions, systemAdmin
  avatar      String?
  status      String   @default("active")
  schoolId    String?  // null = system-level account (not bound to a school)
  systemAdmin Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student  Student?
  teacher  Teacher?
  parent   Parent?
  school   School?  @relation(fields: [schoolId], references: [id])

  authoredAnnouncements Announcement[]
  behaviorRecordsLogged BehaviorRecord[]
  sentMessages          DirectMessage[]
}

// ─── Student ────────────────────────────────────────────────────

model Student {
  id            String   @id @default(uuid())
  userId        String   @unique
  studentId     String   @unique // e.g. "2026001"
  schoolId      String?  // which school this student belongs to
  dateOfBirth   DateTime?
  gender        String?
  nationality   String?
  icNumber      String?  // IC number e.g. BN20100312
  gradeLevel    String?  // e.g. "Year 7" or "Tingkatan 1" or "Year 3" — depends on school type
  className     String?  // e.g. "7A"
  enrollmentStatus String @default("pending") // pending, enrolled, graduated, transferred
  academicStanding String @default("GOOD_STANDING")
  academicStandingUpdatedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
  school        School?  @relation(fields: [schoolId], references: [id])
  parentLinks   ParentStudent[]
  enrollments   Enrollment[]
  attendances   AttendanceRecord[]
  grades        Grade[]
  riskScores    RiskScore[]
  counselorCases CounselorCase[]
  feeInvoices   FeeInvoice[]
  standingHistory AcademicStandingHistory[]
  parentTeacherMeetings ParentTeacherMeeting[]
  submissions     AssignmentSubmission[]
  behaviorRecords BehaviorRecord[]
  ccaEnrollments  CcaEnrollment[]
  ccaAttendances  CcaAttendance[]
  transitions     StudentTransition[] @relation("TransitionStudent")
  examCandidacies ExamCandidate[]
  libraryLoans    LibraryLoan[]
  libraryHolds    LibraryHold[]
  senRecord       SenStudent?
}

// ─── Teacher ────────────────────────────────────────────────────

model Teacher {
  id               String   @id @default(uuid())
  userId           String   @unique
  staffId          String   @unique
  designation      String?
  department       String?
  qualification    String?
  subjects         String?  // comma-separated
  joinDate         DateTime?
  status           String   @default("active")
  cpdHours         Float    @default(0)      // CPD completed hours
  cpdTarget        Float    @default(20)     // CPD annual target (default 20h)
  employmentStatus String   @default("active") // active | onLeave | inTraining
  staffType        String   @default("TEACHING") // TEACHING | ADMINISTRATIVE | SUPPORT | SECURITY
  annualLeaveBalance     Int      @default(14)
  medicalLeaveBalance    Int      @default(14)
  maternityLeaveBalance  Int      @default(90)
  paternityLeaveBalance  Int      @default(7)
  unpaidLeaveBalance     Int      @default(30)
  leaveBalanceYear       String   @default("2025/2026")
  ssmLastSyncedAt        DateTime?
  ssmBalances            String?  // JSON snapshot of SSM leave balances
  dateOfBirth            DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  schoolId         String?  // which school this teacher belongs to

  user            User     @relation(fields: [userId], references: [id])
  school          School?  @relation(fields: [schoolId], references: [id])
  certifications  Certification[]
  courseAssignments CourseAssignment[]
  performanceEvaluations PerformanceEvaluation[]
  timetableSlots  TimetableSlot[]
  leaveApplications LeaveApplication[]
  cpdEnrollments  CpdEnrollment[]
  parentTeacherMeetings ParentTeacherMeeting[]
  assignments     Assignment[]
  staffAttendanceRecords StaffAttendanceRecord[]
  retirementApplication  RetirementApplication?
  awards                 Award[]
  postingHistory         PostingRecord[]
}

// ─── Parent ─────────────────────────────────────────────────────

model Parent {
  id          String   @id @default(uuid())
  userId      String   @unique
  phone       String?
  occupation  String?
  relationship String? // father, mother, guardian
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  childLinks  ParentStudent[]
}

model ParentStudent {
  id        String  @id @default(uuid())
  parentId  String
  studentId String

  parent    Parent  @relation(fields: [parentId], references: [id])
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

// ─── Academic Structure ─────────────────────────────────────────

model School {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique
  authority      String   @default("MOE")  // MOE | MORA | PRIVATE
  schoolType     String   @default("secondary") // primary | secondary | pre_university | vocational | religious_primary | religious_secondary | combined
  address        String?
  phone          String?
  principal      String?
  gradeLevels    String   @default("[\"Year 7\",\"Year 8\",\"Year 9\",\"Year 10\",\"Year 11\"]")  // JSON array
  programmes     String   @default("[\"Academic\"]")  // JSON array
  classLetters   String   @default("[\"A\",\"B\",\"C\",\"D\",\"E\"]")  // JSON array
  establishedYear Int?
  motto          String?
  createdAt      DateTime @default(now())

  users      User[]
  students   Student[]
  teachers   Teacher[]
  courses    Course[]
  rosters    ClassRoster[]
  fromTransitions StudentTransition[] @relation("TransitionFromSchool")
  toTransitions   StudentTransition[] @relation("TransitionToSchool")
}

model Course {
  id          String   @id @default(uuid())
  code        String   // unique within a school — see @@unique below
  name        String
  description String?
  gradeLevel  String?
  creditHours Int      @default(1)
  status      String   @default("active")
  schoolId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school         School? @relation(fields: [schoolId], references: [id])
  assignments    CourseAssignment[]
  enrollments    Enrollment[]
  attendanceSessions AttendanceSession[]
  gradeItems     GradeItem[]
  timetableSlots TimetableSlot[]
  hwAssignments  Assignment[]

  @@unique([code, schoolId])
}

model CourseAssignment {
  id        String  @id @default(uuid())
  courseId   String
  teacherId  String
  semester   String? // e.g. "2026-S1"
  schedule   String? // e.g. "Mon 08:00-09:30"

  course    Course  @relation(fields: [courseId], references: [id])
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  @@unique([courseId, teacherId, semester])
}

model Enrollment {
  id          String   @id @default(uuid())
  studentId   String
  courseId     String
  semester    String?
  status      String   @default("enrolled") // enrolled, dropped, completed
  enrolledAt  DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId, semester])
}

// ─── Attendance ─────────────────────────────────────────────────

model AttendanceSession {
  id        String   @id @default(uuid())
  courseId   String
  date      DateTime
  topic     String?
  token     String?  @unique
  status    String   @default("active")
  createdAt DateTime @default(now())

  course    Course   @relation(fields: [courseId], references: [id])
  records   AttendanceRecord[]
}

model AttendanceRecord {
  id                  String    @id @default(uuid())
  sessionId           String
  studentId           String
  status              String    // present, absent, late, excused
  checkedInAt         DateTime?
  absenceReason       String?   // Sick, Personal, Unexplained, Other
  parentNote          String?   // free-text from parent
  reasonSubmittedAt   DateTime?
  notifiedAt          DateTime? // when push was sent to parent

  session     AttendanceSession @relation(fields: [sessionId], references: [id])
  student     Student           @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
}

// ─── Grades ─────────────────────────────────────────────────────

model GradeItem {
  id          String   @id @default(uuid())
  courseId     String
  name        String   // e.g. "Quiz 1", "Midterm Exam"
  type        String   // quiz, exam, assignment, project
  maxScore    Float
  weight      Float    @default(1.0)
  dueDate     DateTime?
  createdAt   DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id])
  grades      Grade[]
}

model Grade {
  id          String   @id @default(uuid())
  studentId   String
  gradeItemId String
  score       Float?
  letterGrade String?  // A, B, C, D, F
  remarks     String?
  gradedAt    DateTime?
  createdAt   DateTime @default(now())

  student     Student   @relation(fields: [studentId], references: [id])
  gradeItem   GradeItem @relation(fields: [gradeItemId], references: [id])

  @@unique([studentId, gradeItemId])
}

// ─── Certification (EMS) ────────────────────────────────────────

model Certification {
  id          String   @id @default(uuid())
  teacherId   String
  name        String
  issuedBy    String?
  issuedDate  DateTime?
  expiryDate  DateTime?
  status      String   @default("active") // active, expired, pending
  documentUrl String?
  createdAt   DateTime @default(now())

  teacher     Teacher  @relation(fields: [teacherId], references: [id])
}

// ─── Performance Evaluation (EMS) ──────────────────────────────

model PerformanceEvaluation {
  id                String    @id @default(uuid())
  teacherId         String
  academicYear      String    // "2025/2026"
  evaluatorId       String    // HOD User.id
  teachingScore     Float?    // 0-100
  professionalScore Float?    // 0-100
  conductScore      Float?    // 0-100
  overallScore      Float?    // (teaching+professional+conduct)/3
  rating            String?   // Excellent | Good | Satisfactory | NeedsImprovement
  comments          String?
  status            String    @default("draft") // draft | submitted | approved | rejected
  reviewerId        String?   // Principal User.id
  reviewerComments  String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  teacher           Teacher   @relation(fields: [teacherId], references: [id])
}

// ─── Admissions ─────────────────────────────────────────────────

model Admission {
  id                  String   @id @default(uuid())
  applicationNumber   String   @unique @default(uuid()) // e.g. APP-2026-00012
  applicantName       String
  dateOfBirth         DateTime?
  gender              String?
  icNumber            String?
  nationality         String?
  parentName          String?
  parentPhone         String?
  parentEmail         String?
  guardianUserId      String?  // links to User (parent)
  gradeApplied        String   // which year/grade
  programmeStream     String?  // Academic / Vocational / Religious
  previousSchool      String?
  medicalConditions   String?
  status              String   @default("draft") // draft, submitted, under_review, offer_issued, offer_accepted, rejected, waitlisted
  eligibilityScore    Float?   // computed on submit: 0-100
  hasSiblingPriority  Boolean  @default(false)
  siblingName         String?
  siblingStudentId    String?  // matched Student.id
  docsComplete        Boolean  @default(false)
  previousAcademicAvg Float?   // 0-100, from report card
  offerLetterPath     String?  // path to generated PDF
  submittedAt         DateTime?
  decidedAt           DateTime?
  remarks             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  schoolId            String?  // target school for this application
  documents           AdmissionDocument[]
}

model AdmissionDocument {
  id            String   @id @default(uuid())
  admissionId   String
  admission     Admission @relation(fields: [admissionId], references: [id])
  type          String   // BIRTH_CERTIFICATE, REPORT_CARD, IC_COPY, OTHER
  filename      String
  filePath      String?
  uploadedAt    DateTime @default(now())
}

// ─── Finance (SMS) ──────────────────────────────────────────────

model FeeInvoice {
  id               String   @id @default(uuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  invoiceNumber    String?  @unique
  semester         String?
  amount           Float
  status           String   @default("unpaid") // unpaid, paid, overdue
  dueDate          DateTime?
  paidAt           DateTime?
  description      String?
  lineItems        String?  // JSON: [{code, name, amount}]
  holdActive       Boolean  @default(false)
  holdReason       String?
  overdueNotifiedAt DateTime?
  createdAt        DateTime @default(now())
}

model SchoolExpense {
  id                String   @id @default(uuid())
  category          String   // supplies, maintenance, salary, utilities
  description       String
  amount            Float
  date              DateTime
  approvedBy        String?
  status            String   @default("pending") // pending, approved, rejected
  approvalRequestId String?  // links to ApprovalRequest if routing required
  submittedBy       String?  // User.id of submitter
  createdAt         DateTime @default(now())
}

// ─── School Resources (SMS) ─────────────────────────────────────

model Facility {
  id          String   @id @default(uuid())
  name        String
  type        String   // classroom, lab, hall, sports, office
  capacity    Int?
  location    String?
  status      String   @default("available") // available, occupied, maintenance
  createdAt   DateTime @default(now())

  bookings    FacilityBooking[]
}

// ─── Timetable ──────────────────────────────────────────────────
model TimetableSlot {
  id         String  @id @default(uuid())
  courseId   String
  teacherId  String
  gradeLevel String  // "Year 7"
  className  String? // "7A"
  dayOfWeek  Int     // 0=Mon, 1=Tue, 2=Wed, 3=Thu, 4=Fri
  startTime  String  // "08:00"
  endTime    String  // "09:30"
  room       String?
  semester   String  @default("2026-S1")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course  Course  @relation(fields: [courseId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])
}

// ─── Facility Booking ────────────────────────────────────────────
model FacilityBooking {
  id         String   @id @default(uuid())
  facilityId String
  bookedBy   String   // User.id
  purpose    String
  date       DateTime
  startTime  String   // "08:00"
  endTime    String   // "10:00"
  status     String   @default("approved") // pending, approved, cancelled
  createdAt  DateTime @default(now())

  facility   Facility @relation(fields: [facilityId], references: [id])
}

// ─── Notifications ──────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, warning, success, error
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── AI / Chatbot ────────────────────────────────────────────────

model ChatbotConversation {
  id             String   @id @default(uuid())
  userId         String
  messages       String   // JSON array of {role, content, timestamp}
  contextData    String?  // JSON snapshot of context used
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Push Subscriptions (PWA) ────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── School Calendar ─────────────────────────────────────────────

model SchoolEvent {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  endDate     DateTime?
  type        String   @default("event") // holiday, exam, activity, event
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Risk Scores (AI layer) ──────────────────────────────────────

model RiskScore {
  id          String   @id @default(uuid())
  studentId   String
  score       Float    // 0.0 to 1.0
  band        String   // LOW_RISK, MEDIUM_RISK, HIGH_RISK
  absences14d Int      @default(0)   // rolling 14-day absence count
  gradeAvg    Float?   // current term average
  gradeTrend  Float?   // delta from previous term
  computedAt  DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id])
}

// ─── Counselor Cases ─────────────────────────────────────────────

model CounselorCase {
  id              String   @id @default(uuid())
  studentId       String
  counselorUserId String?  // assigned counselor User.id
  openedReason    String   // AUTO_RISK_THRESHOLD, AUTO_ABSENCE_THRESHOLD, TEACHER_REFERRAL, PARENT_REQUEST
  status          String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  notes           String?
  openedAt        DateTime @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student         Student  @relation(fields: [studentId], references: [id])
}

// ─── Leave Applications (EMS) ────────────────────────────────────

model LeaveApplication {
  id                    String    @id @default(uuid())
  teacherId             String
  leaveType             String    // ANNUAL, MEDICAL, MATERNITY, PATERNITY, UNPAID, HAJJ, COMPASSIONATE, EMERGENCY
  startDate             DateTime
  endDate               DateTime
  daysRequested         Int
  reason                String?
  status                String    @default("PENDING") // PENDING, HOD_APPROVED, PRINCIPAL_APPROVED, REJECTED, CANCELLED
  hodApproverId         String?
  hodApprovedAt         DateTime?
  hodRemarks            String?
  principalApproverId   String?
  principalApprovedAt   DateTime?
  principalRemarks      String?
  substituteId          String?
  documentUrl           String?   // medical certificate or supporting doc path
  cancellationReason    String?
  cancelledAt           DateTime?
  cancelledBy           String?   // User.id who cancelled
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  teacher               Teacher   @relation(fields: [teacherId], references: [id])
}

// ─── Audit Events ─────────────────────────────────────────────────

model AuditEvent {
  id          String   @id @default(uuid())
  actorUserId String
  action      String   // APPLICATION_SUBMITTED, APPLICATION_DECIDED, STUDENT_ENROLLED, etc.
  entityType  String?  // Admission, Student, Teacher, etc.
  entityId    String?
  details     String?  // JSON string with additional context (may include before/after values)
  createdAt   DateTime @default(now())
}

// ─── Fee Types (Financial Enforcement) ───────────────────────────

model FeeType {
  id          String   @id @default(uuid())
  code        String   @unique  // TUITION, ACTIVITY, LIBRARY, EXAMINATION
  name        String
  amount      Float
  gradeLevel  String?           // null = applies to all grades; "Year 7" = Year 7 only
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Class Roster (Capacity Enforcement) ─────────────────────────

model ClassRoster {
  id            String   @id @default(uuid())
  gradeLevel    String
  className     String
  academicYear  String   // "2025/2026"
  capacity      Int      @default(35)
  programme     String?
  formTeacherId String?
  schoolId      String?

  school        School?  @relation(fields: [schoolId], references: [id])

  @@unique([className, academicYear, schoolId])
}

// ─── Academic Standing History ────────────────────────────────────

model AcademicStandingHistory {
  id               String   @id @default(uuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  previousStanding String
  newStanding      String
  trigger          String   // GRADE_UPDATE, MANUAL, TERM_CLOSE
  gradeAvg         Float
  thresholdUsed    Float
  createdAt        DateTime @default(now())
}

// ─── Approval Requests (Multi-Level Workflow) ─────────────────────

model ApprovalRequest {
  id               String   @id @default(uuid())
  entityType       String   // SchoolExpense, GradeAmendment, LeaveApplication
  entityId         String
  requestedBy      String   // User.id
  currentLevel     Int      @default(1)    // 1 = HOD, 2 = Principal
  levelsRequired   Int      @default(1)
  status           String   @default("PENDING") // PENDING, LEVEL1_APPROVED, LEVEL2_APPROVED, FULLY_APPROVED, REJECTED
  level1ApproverId String?
  level1ApprovedAt DateTime?
  level1Remarks    String?
  level2ApproverId String?
  level2ApprovedAt DateTime?
  level2Remarks    String?
  rejectedBy       String?
  rejectedAt       DateTime?
  rejectionReason  String?
  metadata         String?  // JSON: { amount, description, entitySummary }
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Grade Amendments ─────────────────────────────────────────────

model GradeAmendment {
  id              String   @id @default(uuid())
  gradeId         String
  teacherId       String
  originalScore   Float
  proposedScore   Float
  reason          String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approverId      String?
  approvedAt      DateTime?
  approverRemarks String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── CPD Workshops ────────────────────────────────────────────────

model CpdWorkshop {
  id           String    @id @default(uuid())
  title        String
  provider     String?
  subject      String?   // Maths, Science, etc — used for filtering
  hours        Float     // CPD hours credited on completion
  startDate    DateTime
  endDate      DateTime
  location     String?
  maxParticipants Int    @default(30)
  status       String    @default("open") // open, full, completed, cancelled
  createdAt    DateTime  @default(now())

  enrollments  CpdEnrollment[]
}

model CpdEnrollment {
  id           String      @id @default(uuid())
  workshopId   String
  teacherId    String
  enrolledAt   DateTime    @default(now())
  status       String      @default("ENROLLED") // ENROLLED, COMPLETED, WITHDRAWN
  completedAt  DateTime?
  hoursAwarded Float?

  workshop     CpdWorkshop @relation(fields: [workshopId], references: [id])
  teacher      Teacher     @relation(fields: [teacherId], references: [id])

  @@unique([workshopId, teacherId])
}

// ─── Parent-Teacher Meetings ──────────────────────────────────────

model ParentTeacherMeeting {
  id            String    @id @default(uuid())
  teacherId     String
  parentUserId  String
  studentId     String
  meetingDate   DateTime
  startTime     String    // "14:00"
  endTime       String    // "14:30"
  purpose       String?
  status        String    @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teacher       Teacher   @relation(fields: [teacherId], references: [id])
  student       Student   @relation(fields: [studentId], references: [id])
}

// ─── File Attachments ─────────────────────────────────────────────

model FileAttachment {
  id           String   @id @default(uuid())
  filename     String   // stored filename on disk (UUID-based)
  originalName String   // original filename from user
  mimeType     String
  size         Int      // bytes
  entityType   String   // admission, certification, leave_application, course, invoice, grade_report, other
  entityId     String?  // ID of the related entity
  uploadedBy   String   // User.id
  description  String?
  createdAt    DateTime @default(now())
}

// ─── Assignments & Homework ──────────────────────────────────────

model Assignment {
  id          String   @id @default(uuid())
  courseId    String
  teacherId   String
  title       String
  description String?
  type        String   @default("homework")  // homework | project | quiz | reading
  dueDate     DateTime?
  maxScore    Float    @default(100)
  status      String   @default("published") // draft | published | closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id])
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  studentId    String
  content      String?
  fileUrl      String?
  submittedAt  DateTime   @default(now())
  isLate       Boolean    @default(false)
  score        Float?
  feedback     String?
  gradedAt     DateTime?
  status       String     @default("submitted") // submitted | late | graded

  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
}

// ─── Announcements ───────────────────────────────────────────────

model Announcement {
  id             String    @id @default(uuid())
  title          String
  content        String
  authorId       String
  targetAudience String    @default("all") // all | students | parents | teachers | grade:Year7
  gradeLevel     String?
  priority       String    @default("normal") // normal | high | urgent
  isPinned       Boolean   @default(false)
  publishedAt    DateTime  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  author         User      @relation(fields: [authorId], references: [id])
}

// ─── Behavior & Discipline ───────────────────────────────────────

model BehaviorRecord {
  id             String   @id @default(uuid())
  studentId      String
  recordedById   String
  type           String   // merit | demerit | incident
  category       String   // academic | conduct | attendance | achievement | other
  points         Int      @default(0)
  description    String
  actionTaken    String?
  severity       String?  // minor | moderate | major
  parentNotified Boolean  @default(false)
  date           DateTime @default(now())
  createdAt      DateTime @default(now())

  student        Student  @relation(fields: [studentId], references: [id])
  recordedBy     User     @relation(fields: [recordedById], references: [id])
}

// ─── Direct Messaging ────────────────────────────────────────────

model MessageThread {
  id            String    @id @default(uuid())
  subject       String
  parentUserId  String
  teacherUserId String
  studentId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages      DirectMessage[]
}

model DirectMessage {
  id        String        @id @default(uuid())
  threadId  String
  senderId  String
  content   String
  readAt    DateTime?
  createdAt DateTime      @default(now())

  thread    MessageThread @relation(fields: [threadId], references: [id])
  sender    User          @relation(fields: [senderId], references: [id])
}

// ─── CCA (Co-Curricular Activities) ─────────────────────────────

model CcaActivity {
  id                String   @id @default(uuid())
  name              String
  category          String   // sports | arts | academic | community | other
  description       String?
  schedule          String?
  venue             String?
  teacherInChargeId String?
  capacity          Int      @default(30)
  status            String   @default("active") // active | inactive
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  enrollments CcaEnrollment[]
  sessions    CcaSession[]
}

model CcaEnrollment {
  id         String      @id @default(uuid())
  ccaId      String
  studentId  String
  enrolledAt DateTime    @default(now())
  status     String      @default("active") // active | withdrawn

  cca        CcaActivity @relation(fields: [ccaId], references: [id])
  student    Student     @relation(fields: [studentId], references: [id])

  @@unique([ccaId, studentId])
}

model CcaSession {
  id        String      @id @default(uuid())
  ccaId     String
  date      DateTime
  notes     String?
  createdAt DateTime    @default(now())

  cca         CcaActivity   @relation(fields: [ccaId], references: [id])
  attendances CcaAttendance[]
}

model CcaAttendance {
  id        String     @id @default(uuid())
  sessionId String
  studentId String
  status    String     @default("present") // present | absent | excused

  session   CcaSession @relation(fields: [sessionId], references: [id])
  student   Student    @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
}

// ─── Education Transitions ───────────────────────────────────────

model StudentTransition {
  id              String   @id @default(uuid())
  studentId       String
  fromSchoolId    String?  // null = student is new to system
  toSchoolId      String
  fromGradeLevel  String?  // "Year 6" or "Darjah 6"
  toGradeLevel    String?  // "Year 7" or "Tingkatan 1"
  fromClassName   String?
  toClassName     String?
  transitionType  String   @default("GRADE_PROMOTION")
  // GRADE_PROMOTION = within same school, one grade up
  // PRIMARY_TO_SECONDARY = cross-school (e.g. primary Year 6 → secondary Year 7)
  // SCHOOL_TRANSFER = mid-year or same-level transfer
  // GRADUATION = completing final grade, leaving system
  academicYear    String   // "2025/2026"
  effectiveDate   DateTime
  status          String   @default("planned")
  // planned | approved | completed | cancelled
  notes           String?
  processedById   String?  // User.id of admin who processed
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  student    Student  @relation("TransitionStudent", fields: [studentId], references: [id])
  fromSchool School?  @relation("TransitionFromSchool", fields: [fromSchoolId], references: [id])
  toSchool   School   @relation("TransitionToSchool", fields: [toSchoolId], references: [id])
}

// ─── Integration Log (SIM-IL) ────────────────────────────────────

model IntegrationLog {
  id          String   @id @default(uuid())
  system      String   // BRUNEI_ID | EGNC | NIH | SSM | KOHA
  endpoint    String
  payloadSize Int      @default(0)
  status      String   @default("success") // success | error
  triggeredBy String?  // User.id who triggered
  createdAt   DateTime @default(now())
}

// ─── Exam Management ─────────────────────────────────────────────

model Exam {
  id         String          @id @default(uuid())
  schoolId   String
  examType   String          // PSR | O_LEVEL | A_LEVEL | IGCSE
  year       Int
  examDate   DateTime
  venue      String?
  status     String          @default("upcoming") // upcoming | ongoing | completed
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  candidates ExamCandidate[]
}

model ExamCandidate {
  id          String  @id @default(uuid())
  examId      String
  studentId   String
  subjectCode String
  seatNumber  String?
  status      String  @default("registered") // registered | present | absent

  exam        Exam    @relation(fields: [examId], references: [id])
  student     Student @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId, subjectCode])
}

// ─── SEN / Special Education ─────────────────────────────────────

model SenStudent {
  id            String          @id @default(uuid())
  studentId     String          @unique
  diagnosisType String          // AUTISM | DYSLEXIA | ADHD | HEARING | VISUAL | PHYSICAL | OTHER
  supportLevel  String          @default("LEVEL_1") // LEVEL_1 | LEVEL_2 | LEVEL_3
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  student       Student         @relation(fields: [studentId], references: [id])
  goals         IepGoal[]
  sessionLogs   IepSessionLog[]
}

model IepGoal {
  id           String     @id @default(uuid())
  senStudentId String
  subject      String
  description  String
  targetDate   DateTime
  status       String     @default("active") // active | achieved | revised
  createdAt    DateTime   @default(now())

  senStudent   SenStudent @relation(fields: [senStudentId], references: [id])
}

model IepSessionLog {
  id           String     @id @default(uuid())
  senStudentId String
  date         DateTime
  durationMins Int
  conductedBy  String     // User.id
  notes        String
  createdAt    DateTime   @default(now())

  senStudent   SenStudent @relation(fields: [senStudentId], references: [id])
}

// ─── Library ─────────────────────────────────────────────────────

model LibraryBook {
  id              String        @id @default(uuid())
  schoolId        String
  isbn            String?
  title           String
  author          String
  category        String        // Fiction | Non-Fiction | Reference | Textbook | Science | History | etc.
  totalCopies     Int           @default(1)
  availableCopies Int           @default(1)
  kohaId          String?       // fake KOHA system ID for provenance
  createdAt       DateTime      @default(now())

  loans           LibraryLoan[]
  holds           LibraryHold[]
}

model LibraryLoan {
  id         String       @id @default(uuid())
  bookId     String
  studentId  String
  borrowedAt DateTime     @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  fineAmount Float        @default(0)

  book       LibraryBook  @relation(fields: [bookId], references: [id])
  student    Student      @relation(fields: [studentId], references: [id])
}

model LibraryHold {
  id          String      @id @default(uuid())
  bookId      String
  studentId   String
  requestedAt DateTime    @default(now())
  status      String      @default("waiting") // waiting | ready | cancelled

  book        LibraryBook @relation(fields: [bookId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])
}

// ─── Inventory / Assets ──────────────────────────────────────────

model AssetCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  schoolId    String?
  createdAt   DateTime @default(now())

  assets      Asset[]
}

model Asset {
  id           String               @id @default(uuid())
  assetTag     String               @unique
  name         String
  categoryId   String
  schoolId     String?
  location     String?
  condition    String               @default("Good") // Good | Fair | Poor | Condemned
  purchaseDate DateTime?
  value        Float?
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  category     AssetCategory        @relation(fields: [categoryId], references: [id])
  maintenanceLogs AssetMaintenanceLog[]
}

model AssetMaintenanceLog {
  id          String   @id @default(uuid())
  assetId     String
  date        DateTime
  type        String   // Repair | Service | Inspection | Disposal
  cost        Float?
  conductedBy String?
  notes       String?
  createdAt   DateTime @default(now())

  asset       Asset    @relation(fields: [assetId], references: [id])
}

// ─── Public Holidays ─────────────────────────────────────────────

model PublicHoliday {
  id        String   @id @default(uuid())
  date      DateTime
  name      String
  schoolId  String?  // null = applies to all schools
  createdAt DateTime @default(now())
}

// ─── Staff Attendance ─────────────────────────────────────────────

model StaffAttendanceRecord {
  id            String    @id @default(uuid())
  teacherId     String
  date          DateTime
  checkInAt     DateTime?
  checkOutAt    DateTime?
  status        String    @default("ABSENT") // PRESENT | LATE | ABSENT
  lateMinutes   Int       @default(0)
  locationLat   Float?
  locationLng   Float?
  locationLabel String?
  autoMarked    Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teacher       Teacher   @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, date])
}

// ─── Awards & Recognition ────────────────────────────────────────

model Award {
  id          String   @id @default(uuid())
  teacherId   String
  title       String
  category    String   @default("EXCELLENCE") // EXCELLENCE | SERVICE | INNOVATION | LEADERSHIP | COMMUNITY | OTHER
  description String?
  awardedDate DateTime
  awardedBy   String?
  badgeColor  String   @default("gold") // gold | silver | bronze | blue | green | purple
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     Teacher  @relation(fields: [teacherId], references: [id])
}

model PostingRecord {
  id          String    @id @default(uuid())
  teacherId   String
  schoolName  String
  position    String
  department  String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teacher     Teacher   @relation(fields: [teacherId], references: [id])
}

// ─── Retirement Planning ──────────────────────────────────────────

model RetirementApplication {
  id              String    @id @default(uuid())
  teacherId       String    @unique
  retirementType  String    @default("NORMAL") // NORMAL | VOLUNTARY_EARLY | MEDICAL
  requestedDate   DateTime
  reason          String?
  documentUrl     String?
  status          String    @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED
  submittedAt     DateTime  @default(now())
  reviewedById    String?
  reviewedAt      DateTime?
  reviewRemarks   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  teacher         Teacher   @relation(fields: [teacherId], references: [id])
}

model StaffAttendanceConfig {
  id                    String   @id @default(uuid())
  schoolId              String   @unique
  startTime             String   @default("07:30")
  cutoffTime            String   @default("09:00")
  absenceAlertDays      Int      @default(3)
  frequentAbsenceDays   Int      @default(3)
  frequentLatenessCount Int      @default(5)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ─── Staff Feedback Surveys ───────────────────────────────────────

model Survey {
  id          String    @id @default(uuid())
  title       String
  description String?
  category    String    @default("GENERAL") // GENERAL | PROFESSIONAL_DEVELOPMENT | WELL_BEING | SCHOOL_MANAGEMENT
  isAnonymous Boolean   @default(true)
  status      String    @default("DRAFT") // DRAFT | ACTIVE | CLOSED
  createdById String
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions   SurveyQuestion[]
  responses   SurveyResponse[]
}

model SurveyQuestion {
  id        String   @id @default(uuid())
  surveyId  String
  order     Int
  text      String
  type      String   @default("RATING") // RATING | TEXT | MULTIPLE_CHOICE | YES_NO
  options   String?  // JSON array for MULTIPLE_CHOICE
  required  Boolean  @default(true)

  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers   SurveyAnswer[]
}

model SurveyResponse {
  id          String   @id @default(uuid())
  surveyId    String
  responderId String?  // null when anonymous
  submittedAt DateTime @default(now())

  survey      Survey        @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers     SurveyAnswer[]

  @@unique([surveyId, responderId])
}

model SurveyAnswer {
  id         String   @id @default(uuid())
  responseId String
  questionId String
  value      String

  response   SurveyResponse  @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   SurveyQuestion  @relation(fields: [questionId], references: [id])
}
